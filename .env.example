# Copy to .env (gitignored). docker compose, Next.js and the Convex CLI all read it.

# --- Paste from your Clerk development app (see README "Clerk checklist") ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard -> Configure -> Convex integration -> Frontend API URL, e.g. https://verb-noun-00.clerk.accounts.dev
CLERK_FRONTEND_API_URL=

# --- Dev-only values below: safe to keep as they are, never reuse in production ---

# Convex self-hosted backend. INSTANCE_NAME/SECRET are pinned so the admin key below stays valid after `docker compose down -v`.
CONVEX_INSTANCE_NAME=lendloop-dev
CONVEX_INSTANCE_SECRET=8ce21c49939e71a7b8be27fa546f09fb6f207a6c5abfb51bb425b5216f22f03b
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=lendloop-dev|01937644edaf7432788a2e5c2a35c410beade10ccf97a8c50d8b884f92c597539568bb3e35
# Lets `next dev` work before the first `convex dev` writes .env.local.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# n8n
N8N_DB_PASSWORD=n8n-dev-only
N8N_ENCRYPTION_KEY=63d5d4308730f32481b4df34181dea8b81ae07952ec7a1c5
N8N_OWNER_EMAIL=admin@lendloop.local

APP_TIMEZONE=UTC
