{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n next,convex -c blue,magenta \"next dev\" \"convex dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && node scripts/n8n-export.mjs --check",
    "format": "prettier --write .",
    "promote": "node scripts/promote.mjs",
    "demo": "node scripts/demo.mjs",
    "reset": "node scripts/reset.mjs",
    "test:n8n": "node --test scripts/test-n8n.mjs",
    "test:demo": "node --test scripts/test-demo.mjs",
    "n8n:export": "node scripts/n8n-export.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.22",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "convex": "1.49.0",
    "convex-helpers": "0.1.129",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "convex-test": "0.0.65",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
