{
  "id": "llReminderWf0001",
  "name": "LendLoop: overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "llErrorWf0000001"
  },
  "nodes": [
    {
      "id": "r01",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, -220],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "r02",
      "name": "Run now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [220, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "reminders/run",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "7bfd84ab-790e-48ae-8ebb-29b7e763be60"
    },
    {
      "id": "r03",
      "name": "Canonical",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst h = item.json.headers;\nconst ts = String(h['x-lendloop-timestamp'] ?? '');\nreturn [{ json: { canonical: ts + '.POST./webhook/reminders/run.' + raw, ts, sig: String(h['x-lendloop-signature'] ?? ''), raw } }];"
      }
    },
    {
      "id": "r04",
      "name": "HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "expected",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "llCryptoC2N00001",
          "name": "LendLoop Convex→n8n secret"
        }
      }
    },
    {
      "id": "r05",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst j = $input.first().json;\nconst m = /^v1=([0-9a-f]{64})$/.exec(j.sig);\nconst now = Math.floor(Date.now() / 1000);\nconst tsOk = /^\\d+$/.test(j.ts) && Math.abs(now - Number(j.ts)) <= 300;\nconst sigOk = !!m && crypto.timingSafeEqual(Buffer.from(m[1], 'hex'), Buffer.from(j.expected, 'hex'));\nlet body = null; try { body = JSON.parse(j.raw); } catch {}\nconst shapeOk = !!body && typeof body === 'object';\nreturn [{ json: { valid: tsOk && sigOk && shapeOk } }];"
      }
    },
    {
      "id": "r06",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "r07",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1320, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\":\"unauthorized\"}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "r08",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1320, 0],
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "r09",
      "name": "Sign GET",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, -110],
      "parameters": {
        "jsCode": "const ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { ts, canonical: ts + '.GET./automation/overdue-loans.' } }];"
      }
    },
    {
      "id": "r10",
      "name": "HMAC GET",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [1760, -110],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "sig",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "llCryptoN2C00001",
          "name": "LendLoop n8n→Convex secret"
        }
      }
    },
    {
      "id": "r11",
      "name": "Get Overdue Loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1980, -110],
      "parameters": {
        "method": "GET",
        "url": "http://convex-backend:3211/automation/overdue-loans",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=v1={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "r12",
      "name": "One item per Loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, -110],
      "parameters": {
        "jsCode": "return ($input.first().json.loans ?? []).map((loan) => ({ json: loan }));"
      }
    },
    {
      "id": "r13",
      "name": "Each Loan",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2420, -110],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "r14",
      "name": "Compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 0],
      "parameters": {
        "jsCode": "const l = $input.first().json;\nconst ago = l.daysOverdue === 1 ? 'yesterday' : l.daysOverdue + ' days ago';\nreturn [{ json: {\n  reminderKey: l.reminderKey,\n  to: l.borrowerEmail,\n  subject: 'Reminder: the ' + l.toolName + ' was due back ' + ago,\n  text: 'Hi ' + l.borrowerFirstName + ',\\n\\nThe ' + l.toolName + ' you borrowed was due back on ' + l.endDate + '. Please return it to its owner as soon as you can, or let them know when you will.\\n\\nLendLoop',\n} }];"
      }
    },
    {
      "id": "r15",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2860, 0],
      "parameters": {
        "fromEmail": "LendLoop <noreply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "llSmtpMailpit001",
          "name": "LendLoop SMTP (Mailpit)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "r16",
      "name": "Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3080, -110],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { writeBack: { reminderKey: $('Compose').item.json.reminderKey, status: 'sent' } } };"
      }
    },
    {
      "id": "r17",
      "name": "Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3080, 110],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json.error;\nconst error = typeof e === 'string' ? e : (e && e.message) || 'The email could not be sent';\nreturn { json: { writeBack: { reminderKey: $('Compose').item.json.reminderKey, status: 'failed', error: String(error).slice(0, 500) } } };"
      }
    },
    {
      "id": "r18",
      "name": "Write-back body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3300, 0],
      "parameters": {
        "jsCode": "const bodyStr = JSON.stringify($input.first().json.writeBack);\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { bodyStr, ts, canonical: ts + '.POST./automation/reminders.' + bodyStr } }];"
      }
    },
    {
      "id": "r19",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [3520, 0],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "sig",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "llCryptoN2C00001",
          "name": "LendLoop n8n→Convex secret"
        }
      }
    },
    {
      "id": "r20",
      "name": "Write back",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [3740, 0],
      "parameters": {
        "method": "POST",
        "url": "http://convex-backend:3211/automation/reminders",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=v1={{ $json.sig }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.bodyStr }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
