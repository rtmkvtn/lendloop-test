      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [1760, 0],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.body.deliveryId }}",
        "options": {
          "scope": "node",
          "historySize": 10000
        }
      }
    },
    {
      "id": "n09",
      "name": "Compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 0],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst tool = b.tool.name;\nconst when = b.dates.start === b.dates.end ? 'on ' + b.dates.start : 'from ' + b.dates.start + ' to ' + b.dates.end;\nconst copy = {\n  'request.created': ['New request for your ' + tool, 'A neighbour would like to borrow your ' + tool + ' ' + when + '. Approve or decline it here:'],\n  'request.cancelled': ['A request for your ' + tool + ' was cancelled', 'The request to borrow your ' + tool + ' ' + when + ' was cancelled. Nothing else to do. Details:'],\n  'request.approved': ['Your request for ' + tool + ' was approved', 'Good news: your request to borrow the ' + tool + ' ' + when + ' was approved. Details:'],\n  'request.declined': ['Your request for ' + tool + ' was declined', 'Your request to borrow the ' + tool + ' ' + when + ' was declined. Details:'],\n  'request.auto_declined': ['Your request for ' + tool + ' was declined', 'The ' + tool + ' was taken off the board, so your request ' + when + ' was declined automatically. Details:'],\n  'request.returned': ['Thanks for returning the ' + tool, 'The ' + tool + ' was marked returned. Thanks for borrowing responsibly. Details:'],\n}[b.event] ?? ['An update on your LendLoop request', 'There is an update on your request for the ' + tool + '. Details:'];\nreturn [{ json: {\n  eventId: b.eventId,\n  to: b.recipient.email,\n  subject: copy[0],\n  text: 'Hi ' + b.recipient.firstName + ',\\n\\n' + copy[1] + '\\n' + b.link + '\\n\\nLendLoop',\n} }];"
      }
    },
    {
      "id": "n10",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2200, 0],
      "parameters": {
        "fromEmail": "LendLoop <noreply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "llSmtpMailpit001",
          "name": "LendLoop SMTP (Mailpit)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "n11",
      "name": "Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2420, 0],
      "parameters": {
        "jsCode": "return [{ json: { writeBack: { eventId: $('Compose').first().json.eventId, status: 'sent' } } }];"
      }
    },
    {
      "id": "n12",
      "name": "Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 220],
      "parameters": {
        "jsCode": "const e = $input.first().json.error;\nconst error = typeof e === 'string' ? e : (e && e.message) || 'The email could not be sent';\nreturn [{ json: { writeBack: { eventId: $('Compose').first().json.eventId, status: 'failed', error: String(error).slice(0, 500) } } }];"
      }
    },
    {
      "id": "n13",
      "name": "Write-back body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 0],
      "parameters": {
        "jsCode": "const bodyStr = JSON.stringify($input.first().json.writeBack);\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { bodyStr, ts, canonical: ts + '.POST./automation/notifications.' + bodyStr } }];"
      }
    },
    {
      "id": "n14",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [3080, 0],
      "parameters": {
        "action": "hmac",
