      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [3300, 0],
      "parameters": {
        "method": "POST",
        "url": "http://convex-backend:3211/automation/notifications",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
