  "nodes": [
    {
      "id": "n01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [220, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop/request-event",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "4c0f7a52-2d6e-4b39-9d5a-1e8f0b6a2301"
    },
    {
      "id": "n02",
      "name": "Canonical",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst h = item.json.headers;\nconst ts = String(h['x-lendloop-timestamp'] ?? '');\nreturn [{ json: { canonical: ts + '.POST./webhook/lendloop/request-event.' + raw, ts, sig: String(h['x-lendloop-signature'] ?? ''), raw } }];"
      }
    },
    {
      "id": "n03",
      "name": "HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "expected",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "llCryptoC2N00001",
          "name": "LendLoop Convex→n8n secret"
        }
      }
    },
    {
      "id": "n04",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst j = $input.first().json;\nconst m = /^v1=([0-9a-f]{64})$/.exec(j.sig);\nconst now = Math.floor(Date.now() / 1000);\nconst tsOk = /^\\d+$/.test(j.ts) && Math.abs(now - Number(j.ts)) <= 300;\nconst sigOk = !!m && crypto.timingSafeEqual(Buffer.from(m[1], 'hex'), Buffer.from(j.expected, 'hex'));\nlet body = null; try { body = JSON.parse(j.raw); } catch {}\nconst shapeOk = !!body && typeof body.eventId === 'string' && typeof body.deliveryId === 'string';\nreturn [{ json: { valid: tsOk && sigOk && shapeOk, body } }];"
      }
    },
    {
      "id": "n05",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n06",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1320, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\":\"unauthorized\"}",
        "options": {
          "responseCode": 401
        }
      }
    },
